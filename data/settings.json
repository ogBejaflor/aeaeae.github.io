{
  "siteTitle": "æ Label Website",
  "background": {
    "image": "assets/images/desktop-background.jpg",
    "fit": "cover",
    "color": "#000000"
  },
  "popups": {
    "enabled": true,
    "minDelay": 10,
    "maxDelay": 40,
    "shuffle": true,
    "welcome": {
      "enabled": true,
      "title": "Hi, I'm Clippy 👋",
      "body": "Welcome to æ. Double-click folders to explore — or open the Terminal and type “help”."
    }
  },
  "gallery": {
    "includeCatalog": true
  },
  "startup": {
    "ambient": true,
    "volume": 0.85,
    "stringVolume": 0.2,
    "effectsVolume": 0.9,
    "targetKey": "auto",
    "bubbleReverb": 0.45,
    "bubbleSpace": 3,
    "dropPitch": 1,
    "stringReverb": 0.5,
    "stringSpace": 4
  }
}
